{
  "name": "@taskshuttle/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry.js": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./scheduler.js": {
      "types": "./dist/scheduler.d.ts",
      "import": "./dist/scheduler.js"
    },
    "./state-machine.js": {
      "types": "./dist/state-machine.d.ts",
      "import": "./dist/state-machine.js"
    },
    "./mutation-gate.js": {
      "types": "./dist/mutation-gate.d.ts",
